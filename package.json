{
  "name": "educade-website",
  "version": "1.0.0",
  "private": true,
  "description": "EDUCADE business website and approved Viking Quest previews",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "wrangler deploy",
    "build:production": "wrangler versions upload --config wrangler.production.jsonc --dry-run --outdir .wrangler/production-build",
    "deploy:production": "node scripts/deploy-production.mjs",
    "test": "node --test tests/*.test.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
